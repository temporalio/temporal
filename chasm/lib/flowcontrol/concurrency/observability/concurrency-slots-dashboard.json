          "refId": "A",
          "expr": "sum by (namespace_id,taskqueue,task_type) (max by (namespace_id,taskqueue,task_type,state) (flowcontrol_concurrency_slots{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"} and ignoring (state) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"} == on (job,namespace_id,taskqueue,task_type) group_left max by (job,namespace_id,taskqueue,task_type) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"}))) * on (namespace_id,taskqueue,task_type,state) group_left max by (namespace_id,taskqueue,task_type,state) (flowcontrol_concurrency_slots{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\",state=~\"RESERVED|COMMITTED\"} * 0 + 1)) / on (namespace_id,taskqueue,task_type) max by (namespace_id,taskqueue,task_type) (flowcontrol_concurrency_slots{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\",state=\"LIMIT\"} and ignoring (state) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"} == on (job,namespace_id,taskqueue,task_type) group_left max by (job,namespace_id,taskqueue,task_type) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"})))",
          "legendFormat": "{{taskqueue}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
