    {
      "type": "timeseries",
      "title": "Slots by state and queue",
      "description": "RESERVED, COMMITTED, AVAILABLE and LIMIT. Latest observer only; no summing across history hosts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace_id,taskqueue,task_type,state) (flowcontrol_concurrency_slots{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"} and ignoring (state) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"} == on (job,namespace_id,taskqueue,task_type) group_left max by (job,namespace_id,taskqueue,task_type) (flowcontrol_concurrency_slots_observed_timestamp{job=~\"$job\",archetype=\"concurrency_limiter\",namespace_id=~\"$namespace_id\",taskqueue=~\"${taskqueue:regex}\"})))",
          "legendFormat": "{{taskqueue}} \u00b7 {{state}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
