    next_relation_callback_operation = set(relation_callback_operation)
    next_relation_nexus_operation_handler_run = set(relation_nexus_operation_handler_run)
    next_exists_Callback.add(callback)
    next_state_Callback[callback] = "unobserved"
    next_relation_callback_handler_run.add((callback, handlerRun))
    exists_Callback = next_exists_Callback
    state_Callback = next_state_Callback
    exists_CallbackDelivery = next_exists_CallbackDelivery
    state_CallbackDelivery = next_state_CallbackDelivery
    exists_CallbackResponse = next_exists_CallbackResponse
