atomic action Action_callback_attach_handler:
    callback = oneof IDs_Callback
    handlerRun = oneof IDs_WorkflowRun
    require callback not in exists_Callback
    require handlerRun in exists_WorkflowRun
    require state_WorkflowRun[handlerRun] == "started"
    next_exists_Callback = set(exists_Callback)
    next_state_Callback = dict(state_Callback)
    next_exists_CallbackDelivery = set(exists_CallbackDelivery)
    next_state_CallbackDelivery = dict(state_CallbackDelivery)
