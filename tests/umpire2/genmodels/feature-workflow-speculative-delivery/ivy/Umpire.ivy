invariant [speculativetaskcreation] (forall Q_run:workflowrun. exists_workflowrun(Q_run) -> (~(~(forall Q_normaltask:workflowtask. ~(exists_workflowtask(Q_normaltask) & ((relation_workflow_task_normal_run(Q_normaltask,Q_run) & (state_workflowtask(Q_normaltask) = workflowtask_state_added | state_workflowtask(Q_normaltask) = workflowtask_state_stored) & ~(forall Q_speculativetask:workflowtask. ~(exists_workflowtask(Q_speculativetask) & ((relation_workflow_task_speculative_run(Q_speculativetask,Q_run) & (state_workflowtask(Q_speculativetask) = workflowtask_state_added | state_workflowtask(Q_speculativetask) = workflowtask_state_stored))))))))))))
