invariant [delivery_no_phantom_dispatch] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> (((state_deliveryattempt(Q_attempt) = deliveryattempt_state_dispatched | state_deliveryattempt(Q_attempt) = deliveryattempt_state_failed | state_deliveryattempt(Q_attempt) = deliveryattempt_state_completed) -> ~(forall Q_task:deliverytask. ~(exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & ~(forall Q_obligation:workobligation. ~(exists_workobligation(Q_obligation) & ((relation_delivery_task_obligation(Q_task,Q_obligation) & state_workobligation(Q_obligation) = workobligation_state_accepted)))))))))))
invariant [delivery_no_resurrection] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> ((state_workobligation(Q_obligation) = workobligation_state_terminal -> (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> ((relation_delivery_task_obligation(Q_task,Q_obligation) -> state_deliverytask(Q_task) = deliverytask_state_retired))))))
