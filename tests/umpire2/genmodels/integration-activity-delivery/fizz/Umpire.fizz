atomic action Action_activity_delivery_retry:
    entity = oneof IDs_Activity
    previous_obligation = oneof IDs_WorkObligation
    previous_task = oneof IDs_DeliveryTask
    obligation = oneof IDs_WorkObligation
    task = oneof IDs_DeliveryTask
    queue = oneof IDs_DeliveryQueue
    require entity in exists_Activity
    require previous_obligation in exists_WorkObligation
    require previous_task in exists_DeliveryTask
    require obligation not in exists_WorkObligation
    require task not in exists_DeliveryTask
    require queue in exists_DeliveryQueue
    require (state_Activity[entity] == "backing_off" and (entity, previous_obligation) in relation_activity_obligation and (entity, previous_task) in relation_activity_delivery_task)
    next_exists_Activity = set(exists_Activity)
    next_state_Activity = dict(state_Activity)
    next_exists_DeliveryAttempt = set(exists_DeliveryAttempt)
    next_state_DeliveryAttempt = dict(state_DeliveryAttempt)
    next_exists_DeliveryQueue = set(exists_DeliveryQueue)
    next_state_DeliveryQueue = dict(state_DeliveryQueue)
    next_exists_DeliveryTask = set(exists_DeliveryTask)
    next_state_DeliveryTask = dict(state_DeliveryTask)
    next_exists_Poller = set(exists_Poller)
    next_state_Poller = dict(state_Poller)
    next_exists_WorkObligation = set(exists_WorkObligation)
    next_state_WorkObligation = dict(state_WorkObligation)
    next_relation_activity_delivery_task = set(relation_activity_delivery_task)
    next_relation_activity_obligation = set(relation_activity_obligation)
    next_relation_delivery_accepted_start = set(relation_delivery_accepted_start)
    next_relation_delivery_attempt_poller = set(relation_delivery_attempt_poller)
    next_relation_delivery_attempt_task = set(relation_delivery_attempt_task)
    next_relation_delivery_task_obligation = set(relation_delivery_task_obligation)
    next_relation_delivery_task_queue = set(relation_delivery_task_queue)
    next_state_Activity[entity] = "scheduled"
    next_relation_activity_obligation.discard((entity, previous_obligation))
    next_relation_activity_delivery_task.discard((entity, previous_task))
    next_exists_WorkObligation.add(obligation)
    next_state_WorkObligation[obligation] = "valid"
    next_exists_DeliveryTask.add(task)
    next_state_DeliveryTask[task] = "pending"
    next_relation_delivery_task_obligation.add((task, obligation))
    next_relation_delivery_task_queue.add((task, queue))
    next_relation_activity_obligation.add((entity, obligation))
    next_relation_activity_delivery_task.add((entity, task))
    exists_Activity = next_exists_Activity
    state_Activity = next_state_Activity
    exists_DeliveryAttempt = next_exists_DeliveryAttempt
    state_DeliveryAttempt = next_state_DeliveryAttempt
    exists_DeliveryQueue = next_exists_DeliveryQueue
    state_DeliveryQueue = next_state_DeliveryQueue
    exists_DeliveryTask = next_exists_DeliveryTask
    state_DeliveryTask = next_state_DeliveryTask
    exists_Poller = next_exists_Poller
    state_Poller = next_state_Poller
    exists_WorkObligation = next_exists_WorkObligation
    state_WorkObligation = next_state_WorkObligation
    relation_activity_delivery_task = next_relation_activity_delivery_task
    relation_activity_obligation = next_relation_activity_obligation
    relation_delivery_accepted_start = next_relation_delivery_accepted_start
    relation_delivery_attempt_poller = next_relation_delivery_attempt_poller
    relation_delivery_attempt_task = next_relation_delivery_attempt_task
    relation_delivery_task_obligation = next_relation_delivery_task_obligation
    relation_delivery_task_queue = next_relation_delivery_task_queue

