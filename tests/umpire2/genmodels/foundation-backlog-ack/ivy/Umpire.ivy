    require exists_deliverytask(task);
    require (state_backlogposition(position) = backlogposition_state_acked & relation_backlog_position_task(position,task) & state_deliverytask(task) = deliverytask_state_retired);
    state_backlogposition(position) := backlogposition_state_gc
}

action backlog_read(position:backlogposition) = {
    require exists_backlogposition(position);
    require state_backlogposition(position) = backlogposition_state_unread;
    state_backlogposition(position) := backlogposition_state_read
}

action delivery_acknowledge(task:deliverytask,attempt:deliveryattempt) = {
    require exists_deliverytask(task);
    require exists_deliveryattempt(attempt);
    require (state_deliverytask(task) = deliverytask_state_dispatched & state_deliveryattempt(attempt) = deliveryattempt_state_dispatched & relation_delivery_attempt_task(attempt,task));
    state_deliverytask(task) := deliverytask_state_acknowledged;
    state_deliveryattempt(attempt) := deliveryattempt_state_completed
}

action delivery_authorize_accept(obligation:workobligation,task:deliverytask,attempt:deliveryattempt) = {
    require exists_workobligation(obligation);
    require exists_deliverytask(task);
    require exists_deliveryattempt(attempt);
    require (state_workobligation(obligation) = workobligation_state_valid & state_deliverytask(task) = deliverytask_state_reserved & state_deliveryattempt(attempt) = deliveryattempt_state_reserved & relation_delivery_task_obligation(task,obligation) & relation_delivery_attempt_task(attempt,task));
    state_deliverytask(task) := deliverytask_state_authorized;
    state_deliveryattempt(attempt) := deliveryattempt_state_accepted;
    state_workobligation(obligation) := workobligation_state_accepted;
    relation_delivery_accepted_start(obligation,attempt) := true
}

action delivery_authorize_reject(obligation:workobligation,task:deliverytask,attempt:deliveryattempt) = {
    require exists_workobligation(obligation);
    require exists_deliverytask(task);
    require exists_deliveryattempt(attempt);
    require (state_workobligation(obligation) = workobligation_state_valid & state_deliverytask(task) = deliverytask_state_reserved & state_deliveryattempt(attempt) = deliveryattempt_state_reserved & relation_delivery_task_obligation(task,obligation) & relation_delivery_attempt_task(attempt,task));
    state_deliverytask(task) := deliverytask_state_backlogged;
    state_deliveryattempt(attempt) := deliveryattempt_state_rejected
}

action delivery_dispatch(task:deliverytask,attempt:deliveryattempt) = {
    require exists_deliverytask(task);
    require exists_deliveryattempt(attempt);
    require (state_deliverytask(task) = deliverytask_state_authorized & state_deliveryattempt(attempt) = deliveryattempt_state_accepted & relation_delivery_attempt_task(attempt,task));
    state_deliverytask(task) := deliverytask_state_dispatched;
    state_deliveryattempt(attempt) := deliveryattempt_state_dispatched
}

