action backlog_ack(position:backlogposition,task:deliverytask) = {
    require exists_backlogposition(position);
    require exists_deliverytask(task);
    require (state_backlogposition(position) = backlogposition_state_read & relation_backlog_position_task(position,task) & (state_deliverytask(task) = deliverytask_state_acknowledged | state_deliverytask(task) = deliverytask_state_retired) & (forall Q_previous:backlogposition. exists_backlogposition(Q_previous) -> ((relation_backlog_position_precedes(Q_previous,position) -> (state_backlogposition(Q_previous) = backlogposition_state_acked | state_backlogposition(Q_previous) = backlogposition_state_gc)))));
    state_backlogposition(position) := backlogposition_state_acked
}

action backlog_append_after(position:backlogposition,previous:backlogposition,task:deliverytask) = {
