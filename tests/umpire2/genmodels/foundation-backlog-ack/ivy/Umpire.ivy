action delivery_spool(task:deliverytask) = {
    require exists_deliverytask(task);
    require ((state_deliverytask(task) = deliverytask_state_pending | state_deliverytask(task) = deliverytask_state_sync_offered) & (exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & ((relation_delivery_task_obligation(task,Q_obligation) & state_workobligation(Q_obligation) = workobligation_state_valid))));
