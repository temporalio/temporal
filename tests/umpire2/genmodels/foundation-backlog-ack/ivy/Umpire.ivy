    require exists_backlogposition(previous);
    require exists_deliverytask(task);
    require (state_deliverytask(task) = deliverytask_state_backlogged & (state_backlogposition(previous) = backlogposition_state_unread | state_backlogposition(previous) = backlogposition_state_read | state_backlogposition(previous) = backlogposition_state_acked | state_backlogposition(previous) = backlogposition_state_gc));
    exists_backlogposition(position) := true;
    state_backlogposition(position) := backlogposition_state_unread;
    relation_backlog_position_task(position,task) := true;
    relation_backlog_position_precedes(previous,position) := true
}

action backlog_append_first(position:backlogposition,task:deliverytask) = {
    require ~exists_backlogposition(position);
    require exists_deliverytask(task);
    require state_deliverytask(task) = deliverytask_state_backlogged;
