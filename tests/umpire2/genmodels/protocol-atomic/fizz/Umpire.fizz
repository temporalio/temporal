atomic action Action_regression_nexus_start_activity:
    activity = oneof IDs_Activity
    operation = oneof IDs_NexusOperation
    require activity not in exists_Activity
    require operation in exists_NexusOperation
    require state_NexusOperation[operation] == "scheduled"
    next_exists_Activity = set(exists_Activity)
    next_state_Activity = dict(state_Activity)
    next_exists_Callback = set(exists_Callback)
    next_state_Callback = dict(state_Callback)
    next_exists_NexusOperation = set(exists_NexusOperation)
