    next_exists_WorkflowRun = set(exists_WorkflowRun)
    next_state_WorkflowRun = dict(state_WorkflowRun)
    next_exists_WorkflowTask = set(exists_WorkflowTask)
    next_state_WorkflowTask = dict(state_WorkflowTask)
    next_relation_activity_nexus = set(relation_activity_nexus)
    next_relation_callback_handler_run = set(relation_callback_handler_run)
    next_relation_callback_operation = set(relation_callback_operation)
    next_relation_nexus_activity = set(relation_nexus_activity)
    next_relation_workflow_run_successor = set(relation_workflow_run_successor)
    next_relation_workflow_runs = set(relation_workflow_runs)
    next_exists_Activity.add(activity)
    next_state_Activity[activity] = "completed"
    next_state_NexusOperation[operation] = "succeeded"
    next_relation_nexus_activity.add((operation, activity))
    next_relation_activity_nexus.add((activity, operation))
    exists_Activity = next_exists_Activity
    state_Activity = next_state_Activity
    exists_Callback = next_exists_Callback
    state_Callback = next_state_Callback
    exists_NexusOperation = next_exists_NexusOperation
    state_NexusOperation = next_state_NexusOperation
    exists_TaskQueue = next_exists_TaskQueue
    state_TaskQueue = next_state_TaskQueue
    exists_Workflow = next_exists_Workflow
    state_Workflow = next_state_Workflow
    exists_WorkflowRun = next_exists_WorkflowRun
    state_WorkflowRun = next_state_WorkflowRun
    exists_WorkflowTask = next_exists_WorkflowTask
    state_WorkflowTask = next_state_WorkflowTask
    relation_activity_nexus = next_relation_activity_nexus
    relation_callback_handler_run = next_relation_callback_handler_run
    relation_callback_operation = next_relation_callback_operation
    relation_nexus_activity = next_relation_nexus_activity
    relation_workflow_run_successor = next_relation_workflow_run_successor
    relation_workflow_runs = next_relation_workflow_runs

