    require (state_WorkObligation[obligation] == "valid" and (state_DeliveryTask[task] == "pending" or state_DeliveryTask[task] == "sync-offered" or state_DeliveryTask[task] == "backlogged") and (task, obligation) in relation_delivery_task_obligation)
