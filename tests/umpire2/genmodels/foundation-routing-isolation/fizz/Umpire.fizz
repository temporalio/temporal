atomic action Action_routing_handoff:
    partition = oneof IDs_MatchingQueuePartition
    oldGeneration = oneof IDs_MatchingOwnerGeneration
    newGeneration = oneof IDs_MatchingOwnerGeneration
    require partition in exists_MatchingQueuePartition
    require oldGeneration in exists_MatchingOwnerGeneration
    require newGeneration not in exists_MatchingOwnerGeneration
    require (state_MatchingOwnerGeneration[oldGeneration] == "current" and (partition, oldGeneration) in relation_delivery_partition_owner and ((not ("DeliveryTask#0" in exists_DeliveryTask) or ((not (("DeliveryTask#0", oldGeneration) in relation_delivery_task_owner_generation) or ((state_DeliveryTask["DeliveryTask#0"] == "acknowledged" or state_DeliveryTask["DeliveryTask#0"] == "retired"))))) and (not ("DeliveryTask#1" in exists_DeliveryTask) or ((not (("DeliveryTask#1", oldGeneration) in relation_delivery_task_owner_generation) or ((state_DeliveryTask["DeliveryTask#1"] == "acknowledged" or state_DeliveryTask["DeliveryTask#1"] == "retired")))))))
