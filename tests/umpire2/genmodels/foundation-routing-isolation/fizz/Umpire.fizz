atomic action Action_routing_reserve_compatible:
    task = oneof IDs_DeliveryTask
    attempt = oneof IDs_DeliveryAttempt
    poller = oneof IDs_Poller
    route = oneof IDs_DeliveryRouteClass
    partition = oneof IDs_MatchingQueuePartition
    generation = oneof IDs_MatchingOwnerGeneration
    require task in exists_DeliveryTask
    require attempt not in exists_DeliveryAttempt
    require poller in exists_Poller
    require route in exists_DeliveryRouteClass
    require partition in exists_MatchingQueuePartition
    require generation in exists_MatchingOwnerGeneration
    require ((state_DeliveryTask[task] == "sync-offered" or state_DeliveryTask[task] == "backlogged") and (task, route) in relation_delivery_task_route and (poller, route) in relation_delivery_poller_route and (partition, route) in relation_delivery_partition_route and (partition, generation) in relation_delivery_partition_owner and (task, generation) in relation_delivery_task_owner_generation and state_MatchingOwnerGeneration[generation] == "current")
    next_exists_DeliveryAttempt = set(exists_DeliveryAttempt)
    next_state_DeliveryAttempt = dict(state_DeliveryAttempt)
    next_exists_DeliveryQueue = set(exists_DeliveryQueue)
    next_state_DeliveryQueue = dict(state_DeliveryQueue)
    next_exists_DeliveryRouteClass = set(exists_DeliveryRouteClass)
    next_state_DeliveryRouteClass = dict(state_DeliveryRouteClass)
