    next_relation_delivery_task_route = set(relation_delivery_task_route)
    next_relation_history_shard_owner = set(relation_history_shard_owner)
    next_state_DeliveryTask[task] = "reserved"
    next_exists_DeliveryAttempt.add(attempt)
    next_state_DeliveryAttempt[attempt] = "reserved"
    next_relation_delivery_attempt_task.add((attempt, task))
    next_relation_delivery_attempt_poller.add((attempt, poller))
    exists_DeliveryAttempt = next_exists_DeliveryAttempt
    state_DeliveryAttempt = next_state_DeliveryAttempt
