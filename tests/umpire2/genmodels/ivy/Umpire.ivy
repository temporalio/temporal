action regression_nexus_start_activity(activity:activity,operation:nexusoperation) = {
    require ~exists_activity(activity);
    require exists_nexusoperation(operation);
    require state_nexusoperation(operation) = nexusoperation_state_scheduled;
    exists_activity(activity) := true;
    state_activity(activity) := activity_state_completed;
    state_nexusoperation(operation) := nexusoperation_state_succeeded;
    relation_nexus_activity(operation,activity) := true;
    relation_activity_nexus(activity,operation) := true
}

