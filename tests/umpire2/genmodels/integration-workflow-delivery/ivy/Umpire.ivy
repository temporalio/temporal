invariant [delivery_destination_isolation] (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> ((exists Q_queue:deliveryqueue. exists_deliveryqueue(Q_queue) & (relation_delivery_task_queue(Q_task,Q_queue)))))
invariant [delivery_failed_start_is_not_accepted] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> ((state_deliveryattempt(Q_attempt) = deliveryattempt_state_rejected -> (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> (~(relation_delivery_accepted_start(Q_obligation,Q_attempt)))))))
invariant [delivery_no_phantom_dispatch] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> (((state_deliveryattempt(Q_attempt) = deliveryattempt_state_dispatched | state_deliveryattempt(Q_attempt) = deliveryattempt_state_failed | state_deliveryattempt(Q_attempt) = deliveryattempt_state_completed) -> (exists Q_task:deliverytask. exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & (exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & ((relation_delivery_task_obligation(Q_task,Q_obligation) & state_workobligation(Q_obligation) = workobligation_state_accepted)))))))))
invariant [delivery_no_resurrection] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> ((state_workobligation(Q_obligation) = workobligation_state_terminal -> (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> ((relation_delivery_task_obligation(Q_task,Q_obligation) -> state_deliverytask(Q_task) = deliverytask_state_retired))))))
invariant [delivery_no_split_commit] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> (((state_workobligation(Q_obligation) = workobligation_state_valid | state_workobligation(Q_obligation) = workobligation_state_accepted) -> (exists Q_task:deliverytask. exists_deliverytask(Q_task) & (relation_delivery_task_obligation(Q_task,Q_obligation))))))
invariant [delivery_path_equivalence] (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> (((exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & (relation_delivery_task_obligation(Q_task,Q_obligation))) & (exists Q_queue:deliveryqueue. exists_deliveryqueue(Q_queue) & (relation_delivery_task_queue(Q_task,Q_queue))))))
invariant [delivery_retry_preserves_obligation] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> ((exists Q_task:deliverytask. exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & (exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & (relation_delivery_task_obligation(Q_task,Q_obligation))))))))
invariant [delivery_single_accepted_start] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> ((state_workobligation(Q_obligation) = workobligation_state_accepted -> (exists Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) & (relation_delivery_accepted_start(Q_obligation,Q_attempt))))))
invariant [workflow_delivery_accepted_start_correspondence] (forall Q_workflowtask:workflowtask. exists_workflowtask(Q_workflowtask) -> ((state_workflowtask(Q_workflowtask) = workflowtask_state_polled -> (exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & ((relation_workflow_task_obligation(Q_workflowtask,Q_obligation) & state_workobligation(Q_obligation) = workobligation_state_accepted & (exists Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) & (relation_delivery_accepted_start(Q_obligation,Q_attempt)))))))))
invariant [workflow_delivery_intent_correspondence] (forall Q_workflowtask:workflowtask. exists_workflowtask(Q_workflowtask) -> (((state_workflowtask(Q_workflowtask) = workflowtask_state_added | state_workflowtask(Q_workflowtask) = workflowtask_state_stored | state_workflowtask(Q_workflowtask) = workflowtask_state_polled) -> ((exists Q_obligation:workobligation. exists_workobligation(Q_obligation) & (relation_workflow_task_obligation(Q_workflowtask,Q_obligation))) & (exists Q_deliverytask:deliverytask. exists_deliverytask(Q_deliverytask) & (relation_workflow_task_delivery_task(Q_workflowtask,Q_deliverytask)))))))

