invariant [delivery_no_phantom_dispatch] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> (((state_deliveryattempt(Q_attempt) = deliveryattempt_state_dispatched | state_deliveryattempt(Q_attempt) = deliveryattempt_state_failed | state_deliveryattempt(Q_attempt) = deliveryattempt_state_completed) -> ~(forall Q_task:deliverytask. ~(exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & ~(forall Q_obligation:workobligation. ~(exists_workobligation(Q_obligation) & ((relation_delivery_task_obligation(Q_task,Q_obligation) & state_workobligation(Q_obligation) = workobligation_state_accepted)))))))))))
invariant [delivery_no_resurrection] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> ((state_workobligation(Q_obligation) = workobligation_state_terminal -> (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> ((relation_delivery_task_obligation(Q_task,Q_obligation) -> state_deliverytask(Q_task) = deliverytask_state_retired))))))
invariant [delivery_no_split_commit] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> (((state_workobligation(Q_obligation) = workobligation_state_valid | state_workobligation(Q_obligation) = workobligation_state_accepted) -> ~(forall Q_task:deliverytask. ~(exists_deliverytask(Q_task) & (relation_delivery_task_obligation(Q_task,Q_obligation)))))))
invariant [delivery_owner_generation_fencing] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> (((state_deliveryattempt(Q_attempt) = deliveryattempt_state_reserved | state_deliveryattempt(Q_attempt) = deliveryattempt_state_accepted | state_deliveryattempt(Q_attempt) = deliveryattempt_state_dispatched) -> ~(forall Q_task:deliverytask. ~(exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & ~(forall Q_generation:matchingownergeneration. ~(exists_matchingownergeneration(Q_generation) & ((relation_delivery_task_owner_generation(Q_task,Q_generation) & state_matchingownergeneration(Q_generation) = matchingownergeneration_state_current)))) & ~(forall Q_historygeneration:historyownergeneration. ~(exists_historyownergeneration(Q_historygeneration) & ((relation_delivery_task_history_owner_generation(Q_task,Q_historygeneration) & state_historyownergeneration(Q_historygeneration) = historyownergeneration_state_current)))))))))))
invariant [delivery_path_equivalence] (forall Q_task:deliverytask. exists_deliverytask(Q_task) -> ((~(forall Q_obligation:workobligation. ~(exists_workobligation(Q_obligation) & (relation_delivery_task_obligation(Q_task,Q_obligation)))) & ~(forall Q_queue:deliveryqueue. ~(exists_deliveryqueue(Q_queue) & (relation_delivery_task_queue(Q_task,Q_queue)))))))
invariant [delivery_retry_preserves_obligation] (forall Q_attempt:deliveryattempt. exists_deliveryattempt(Q_attempt) -> (~(forall Q_task:deliverytask. ~(exists_deliverytask(Q_task) & ((relation_delivery_attempt_task(Q_attempt,Q_task) & ~(forall Q_obligation:workobligation. ~(exists_workobligation(Q_obligation) & (relation_delivery_task_obligation(Q_task,Q_obligation))))))))))
invariant [delivery_single_accepted_start] (forall Q_obligation:workobligation. exists_workobligation(Q_obligation) -> ((state_workobligation(Q_obligation) = workobligation_state_accepted -> ~(forall Q_attempt:deliveryattempt. ~(exists_deliveryattempt(Q_attempt) & (relation_delivery_accepted_start(Q_obligation,Q_attempt)))))))

